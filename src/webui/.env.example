# Copy to .env and fill in values

# Local Ollama (default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest

# n8n — import AI_Property_Triage_n8n.json, then:
N8N_WEBHOOK_URL=http://localhost:5678/webhook/property-triage

USE_LOCAL_PIPELINE=false
# Local dev without n8n: run scripts/start-all.ps1, then set USE_LOCAL_PIPELINE=true
LOCAL_PIPELINE_URL=http://127.0.0.1:8090/run
