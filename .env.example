# =============================================================================
# AI Property Triage — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# LAYER 1 — WebUI (Streamlit)
# Owner: teammate
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest

# -----------------------------------------------------------------------------
# LAYER 2 — n8n Orchestration
# Owner: teammate
# Import src/n8n/AI_Property_Triage_n8n.json into n8n, then paste webhook URL:
# -----------------------------------------------------------------------------
N8N_WEBHOOK_URL=http://localhost:5678/webhook/property-triage


# Request timeout for n8n webhook (seconds)
REQUEST_TIMEOUT=120

# -----------------------------------------------------------------------------
# LAYER 2 — LLM APIs used by n8n nodes (Node 4, 5, 6)
# Get a free key at: aistudio.google.com
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=

# -----------------------------------------------------------------------------
# LAYER 3 — EC2 Microservices
# Owner: Muhammad
# -----------------------------------------------------------------------------

# Service 1 — RAG Service (port 8001)

# --- Insight LLM: ollama (default) or llamacpp ---
LLM_BACKEND=ollama                       # "ollama" or "llamacpp"
# If LLM_BACKEND=ollama, reuses OLLAMA_BASE_URL and OLLAMA_MODEL from Layer 1 above.
# If LLM_BACKEND=llamacpp, the GGUF model is downloaded automatically from HuggingFace.

VECTOR_STORE=chroma                      # "chroma" (default, local) or "pinecone"
PINECONE_API_KEY=                        # Required only if VECTOR_STORE=pinecone
PINECONE_INDEX_NAME=                     # Required only if VECTOR_STORE=pinecone

# Service 2 — Image Analyser (port 8002)
IMAGE_CONFIDENCE_THRESHOLD=0.6           # Confidence cutoff for room classification (0.0–1.0)

# Service 4 — LangGraph Agent (port 8004) — internal service-to-service URLs
RAG_SERVICE_URL=http://localhost:8001
IMAGE_ANALYSER_URL=http://localhost:8002
HTTP_TIMEOUT=30

# -----------------------------------------------------------------------------
# LAYER 4 — External LLM APIs
# Owner: Muhammad
# Used by: Guardrails Service (NeMo) + LangGraph Agent (gpt-4o-mini)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
